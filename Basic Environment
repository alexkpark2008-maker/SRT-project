import random

grid = [[0 for i in range(20)] for i in range(20)]

#spawing location
startRow = 0
startColumn = random.randint(0, 19)


#gem location
gemRow = random.randint(9, 19)
gemColumn = random.randint(0, 19)

numObjectivesMet = 0



def randomObstacles(objects):
    #make that many obstacles
    for i in range(objects):
        block = random.randint(0, 399)
        row = block // 20
        column = block % 20

        #asign 3 different values for 3 different types of obstacles
        obstacleType = random.randint(0, 2)
        grid[row][column] = obstacleType
    grid[startRow][startColumn] = 0
    grid[gemRow][gemColumn] = 0

    print(startRow, startColumn)
    print(gemRow, gemColumn)
    return None


def basicBot():
    moving = True
    numMoves = 0
    objectiveMet = False
    while moving:
        global startRow, startColumn, numObjectivesMet
        if startRow < 19 and grid[startRow + 1][startColumn] == 0:
            startRow += 1
            numMoves += 1
        

        elif startColumn < 19 and grid[startRow][startColumn + 1] == 0:
            startColumn += 1
            numMoves += 1

       
        elif startColumn > 0 and grid[startRow][startColumn - 1] == 0:
            startColumn -= 1
            numMoves += 1
        else:
            moving = False
            print(numMoves)
            print(objectiveMet)
        
        if startRow == gemRow and startColumn == gemColumn:
            moving = False
            print(numMoves)
            print(objectiveMet)
            objectiveMet = True
            numObjectivesMet += 1
            print(objectiveMet)
        if numMoves > 99:
            moving = False
            print(numMoves)
            print(objectiveMet)

    return None
    

#code for visual Grid
def visualGrid():
    virtualGrid = ""
    RowState = -1
    ColumnState = -1
    for row in grid:
        RowState += 1
        for column in row:
            ColumnState += 1
            ColumnState = ColumnState % 20
                
            if RowState == startRow and ColumnState == startColumn:
                virtualGrid += " T "

            elif RowState == gemRow and ColumnState == gemColumn:
                virtualGrid += " G "
            else:
                virtualGrid += f" {column} "
        virtualGrid += "\n"
    print(virtualGrid)

#run code 10 times to see if complete mission
for i in range(1000):
    randomObstacles(150)
    basicBot()
    print(startRow, startColumn)
    visualGrid()
    startRow = 0
    startColumn = random.randint(0, 19)

    gemRow = random.randint(9, 19)
    gemColumn = random.randint(0, 19)
    for row in range(20):
        for column in range(20):
            grid[row][column] = 0

print(numObjectivesMet)




            




