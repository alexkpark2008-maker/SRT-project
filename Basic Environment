import random

grid = [[0 for i in range(20)] for i in range(20)]

#spawing location
startRow = 0
startColumn = random.randint(0, 19)


#gem location
gemRow = random.randint(9, 19)
gemColumn = random.randint(0, 19)


numObjectivesMet = 0
numMoves = 0

def possiblePath():
    global startRow, startColumn, gemRow, gemColumn

    pathlist = []

    row = startRow
    column = startColumn
    pathlist.append((row, column))

    while row != gemRow or column != gemColumn:
        possibleMoves = []
        if row < gemRow:
            possibleMoves.append((row + 1, column))
        if row > gemRow:
            possibleMoves.append((row - 1, column))
        if column < gemColumn:
            possibleMoves.append((row, column + 1))
        if column > gemColumn:
            possibleMoves.append((row, column - 1))
        row, column = random.choice(possibleMoves)
        pathlist.append((row, column))


    return pathlist


def Obstacles(cliffs, rivers, trees):

    def cliff():
        startCliff = random.randint(0, 399)
        row = startCliff // 20
        column = startCliff % 20

        cliffLength = random.randint(20, 30)
        upDown = random.randint(0, 1)

        while cliffLength > 0 and 0 <= row < 20 and 0 <= column < 20:
            grid[row][column] = 1
            if upDown == 0:
                row += 1
            else:
                column += 1
            cliffLength -= 1

    def river():
        attempts = 0

        while attempts < 1000:
            startRiver = random.randint(0, 399)
            row = startRiver // 20
            column = startRiver % 20

            if grid[row][column] == 0:
                break

            attempts += 1

        if attempts >= 1000:
            return

        riverLength = random.randint(10, 20)

        for _ in range(riverLength):
            if not (0 <= row < 20 and 0 <= column < 20):
                break

            if grid[row][column] == 1:
                break

            grid[row][column] = 2

            riverDirection = random.randint(0, 4)

            if riverDirection == 0:
                row += 1
            elif riverDirection == 1:
                column += 1
            elif riverDirection == 2:
                column -= 1
            elif riverDirection == 3:
                row += 1
                column += 1
            else:
                row += 1
                column -= 1
    
    def tree():
        startTree = random.randint(0, 399)
        row = startTree // 20
        column = startTree % 20

        if grid[row][column] == 0:
            if (
                (row == 0 or grid[row - 1][column] != 3) and
                (row == 19 or grid[row + 1][column] != 3) and
                (column == 0 or grid[row][column - 1] != 3) and
                (column == 19 or grid[row][column + 1] != 3)
            ):
                grid[row][column] = 3
        else:
            return

    for _ in range(cliffs):
        cliff()
    for _ in range(rivers):
        river()
    for _ in range(trees):
        tree()

    pathList = possiblePath()
    for i in pathList:
        grid[i[0]][i[1]] = 0

    grid[startRow][startColumn] = 0
    grid[gemRow][gemColumn] = 0

    print(f"Start Row: {startRow}, Start Column: {startColumn}")
    print(f"Gem Row: {gemRow}, Gem Column: {gemColumn}")
    return None

def gemIsInterceptable():
    visited = set()
    queue = [(startRow, startColumn)]

    while queue:
        row, col = queue.pop(0)

        if (row, col) in visited:
            continue

        if row < 0 or row >= 20 or col < 0 or col >= 20:
            continue

        if grid[row][col] == 1:
            continue

        if row == gemRow and col == gemColumn:
            return True

        visited.add((row, col))

        queue.append((row + 1, col))
        queue.append((row - 1, col))
        queue.append((row, col + 1))
        queue.append((row, col - 1))

    return False

def disturbances():
    def moveGem():
        possibleSpot = False
        global gemRow, gemColumn
        while not possibleSpot:
            gemRow = random.randint(9, 19)
            gemColumn = random.randint(0, 19)
            if grid[gemRow][gemColumn] == 0:
                possibleSpot = True
    runif = random.randint(0, 2)
    disturbance = random.randint(0, 1)
    if runif == 0:
        if disturbance == 0:
            moveGem()
        else:
            Obstacles(1, 1)

def basicBot():
    moving = True
    objectiveMet = False
    while moving:
        #disturbances()
        global startRow, startColumn, numObjectivesMet, numMoves
        if startRow < 19 and grid[startRow + 1][startColumn] == 0:
            startRow += 1
            numMoves += 1
        

        elif startColumn < 19 and grid[startRow][startColumn + 1] == 0:
            startColumn += 1
            numMoves += 1

       
        elif startColumn > 0 and grid[startRow][startColumn - 1] == 0:
            startColumn -= 1
            numMoves += 1
        else:
            moving = False
            print(f"Number of moves: {numMoves}")
            print(f"Objective met: {objectiveMet}")

        if startRow == gemRow and startColumn == gemColumn:
            moving = False
            print(f"Number of moves: {numMoves}")
            objectiveMet = True
            numObjectivesMet += 1
            print(f"Objective met: {objectiveMet}")
        if numMoves > 99:
            moving = False
            print(f"Number of moves: {numMoves}")
            print(f"Objective met: {objectiveMet}")
    return None


#code for visual Grid
def visualGrid():
    virtualGrid = ""
    RowState = -1
    ColumnState = -1
    for row in grid:
        RowState += 1
        for column in row:
            ColumnState += 1
            ColumnState = ColumnState % 20
                
            if RowState == startRow and ColumnState == startColumn:
                virtualGrid += " T "

            elif RowState == gemRow and ColumnState == gemColumn:
                virtualGrid += " G "
            else:
                virtualGrid += f" {column} "
        virtualGrid += "\n"
    print(virtualGrid)


possible = 0
#run code 1000 times to see if 
for i in range(1000):
    Obstacles(2, 2, 150)
    basicBot()
    if gemIsInterceptable():
        possible += 1

    print(f"Turtle Row: {startRow}, Turtle Column: {startColumn}")
    visualGrid()
    
    startRow = 0
    startColumn = random.randint(0, 19)

    gemRow = random.randint(9, 19)
    gemColumn = random.randint(0, 19)
    for row in range(20):
        for column in range(20):
            grid[row][column] = 0
    numMoves = 0

print(f"Percent of environments where gem is interceptable: {possible/10}%")
