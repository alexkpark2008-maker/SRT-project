import random
import heapq


grid = [[0 for i in range(20)] for i in range(20)]

#spawing location
startRow = 0
startColumn = random.randint(0, 19)


#gem location
gemRow = random.randint(9, 19)
gemColumn = random.randint(0, 19)


numObjectivesMet = 0
numMoves = 0

def possiblePath():
    global startRow, startColumn, gemRow, gemColumn

    pathlist = []

    row = startRow
    column = startColumn
    pathlist.append((row, column))

    while row != gemRow or column != gemColumn:
        possibleMoves = []
        if row < gemRow:
            possibleMoves.append((row + 1, column))
        if row > gemRow:
            possibleMoves.append((row - 1, column))
        if column < gemColumn:
            possibleMoves.append((row, column + 1))
        if column > gemColumn:
            possibleMoves.append((row, column - 1))
        row, column = random.choice(possibleMoves)
        pathlist.append((row, column))


    return pathlist


def Obstacles(cliffs, rivers, trees):

    def cliff():
        startCliff = random.randint(0, 399)
        row = startCliff // 20
        column = startCliff % 20

        cliffLength = random.randint(10, 20)
        upDown = random.randint(0, 1)

        while cliffLength > 0 and 0 <= row < 20 and 0 <= column < 20:
            grid[row][column] = 1
            if upDown == 0:
                row += 1
            else:
                column += 1
            cliffLength -= 1

    def river():
        attempts = 0

        while attempts < 1000:
            startRiver = random.randint(0, 399)
            row = startRiver // 20
            column = startRiver % 20

            if grid[row][column] == 0:
                break

            attempts += 1

        if attempts >= 1000:
            return

        riverLength = random.randint(10, 20)

        for _ in range(riverLength):
            if not (0 <= row < 20 and 0 <= column < 20):
                break

            if grid[row][column] == 1:
                break

            grid[row][column] = 2

            riverDirection = random.randint(0, 4)

            if riverDirection == 0:
                row += 1
            elif riverDirection == 1:
                column += 1
            elif riverDirection == 2:
                column -= 1
            elif riverDirection == 3:
                row += 1
                column += 1
            else:
                row += 1
                column -= 1
    
    def tree():
        startTree = random.randint(0, 399)
        row = startTree // 20
        column = startTree % 20

        if grid[row][column] == 0:
            if (
                (row == 0 or grid[row - 1][column] != 3) and
                (row == 19 or grid[row + 1][column] != 3) and
                (column == 0 or grid[row][column - 1] != 3) and
                (column == 19 or grid[row][column + 1] != 3)
            ):
                grid[row][column] = 3
        else:
            return

    for _ in range(cliffs):
        cliff()
    for _ in range(rivers):
        river()
    for _ in range(trees):
        tree()

    pathList = possiblePath()
    for i in pathList:
        grid[i[0]][i[1]] = 0

    grid[startRow][startColumn] = 0
    grid[gemRow][gemColumn] = 0

    print(f"Start Row: {startRow}, Start Column: {startColumn}")
    print(f"Gem Row: {gemRow}, Gem Column: {gemColumn}")
    return None

def gemIsInterceptable():
    visited = set()
    queue = [(startRow, startColumn)]

    while queue:
        row, col = queue.pop(0)

        if (row, col) in visited:
            continue

        if row < 0 or row >= 20 or col < 0 or col >= 20:
            continue

        if grid[row][col] == 1:
            continue

        if row == gemRow and col == gemColumn:
            return True

        visited.add((row, col))

        queue.append((row + 1, col))
        queue.append((row - 1, col))
        queue.append((row, col + 1))
        queue.append((row, col - 1))

    return False

def disturbances():
    def moveGem():
        possibleSpot = False
        global gemRow, gemColumn
        while not possibleSpot:
            gemRow = random.randint(9, 19)
            gemColumn = random.randint(0, 19)
            if grid[gemRow][gemColumn] == 0:
                possibleSpot = True
    runif = random.randint(0, 2)
    disturbance = random.randint(0, 1)
    if runif == 0:
        if disturbance == 0:
            moveGem()
        else:
            Obstacles(1, 1)

def frontierBot():

    global startRow, startColumn, numObjectivesMet, numMoves
 

    UNKNOWN = -1
    DIRECTIONS = [(1, 0), (-1, 0), (0, 1), (0, -1)]
 
    knownGrid = [[UNKNOWN for _ in range(20)] for _ in range(20)]
    gemPos = None
 
    def identifyFrontier():
        nonlocal gemPos
        for r in range(startRow - 2, startRow + 3):
            for c in range(startColumn - 2, startColumn + 3):
                if 0 <= r < 20 and 0 <= c < 20:
                    knownGrid[r][c] = grid[r][c]
                    if (r, c) == (gemRow, gemColumn):
                        gemPos = (r, c)
 
    def stepCost(row, col):
        if knownGrid[row][col] == 0:
            return 1
        if knownGrid[row][col] == 2:
            return 2
        return None
 
    def isFrontier(row, col):
        if stepCost(row, col) is None:
            return False
        for dr, dc in DIRECTIONS:
            nr, nc = row + dr, col + dc
            if 0 <= nr < 20 and 0 <= nc < 20 and knownGrid[nr][nc] == UNKNOWN:
                return True
        return False
 
    def dijkstra():

        start = (startRow, startColumn)
        costs = {start: 0}
        previous = {}
        queue = [(0, start)]
 
        while queue:
            cost, (row, column) = heapq.heappop(queue)
            if cost > costs[(row, column)]:
                continue
            for drow, dcol in DIRECTIONS:
                nr, nc = row + drow, column + dcol
                if not (0 <= nr < 20 and 0 <= nc < 20):
                    continue
                step = stepCost(nr, nc)
                if step is None:
                    continue
                newCost = cost + step
                if newCost < costs.get((nr, nc), float("inf")):
                    costs[(nr, nc)] = newCost
                    previous[(nr, nc)] = (row, column)
                    heapq.heappush(queue, (newCost, (nr, nc)))
        return costs, previous
 
    def buildPath(target, previous):
        path = []
        current = target
        start = (startRow, startColumn)
        while current != start:
            path.append(current)
            current = previous[current]
        path.reverse()
        return path
 
    def chooseTarget(costs):
        if gemPos is not None and gemPos in costs:
            return gemPos

        best, bestScore = None, float("inf")
        for (row, column), cost in costs.items():
            if (row, column) == (startRow, startColumn) or not isFrontier(row, column):
                continue
            score = cost + max(0, 9 - row)
            if score < bestScore:
                best, bestScore = (row, column), score
        return best
 
    movesThisRun = 0
 
    while movesThisRun < 200:
        identifyFrontier()
 
        if (startRow, startColumn) == (gemRow, gemColumn):
            numObjectivesMet += 1
            print("Objective met: True")
            print(f"Number of moves: {numMoves}")
            return
 
        costs, previous = dijkstra()
        target = chooseTarget(costs)
 
        if target is None:
            print("Objective met: False")
            print("No reachable frontier left.")
            print(f"Number of moves: {numMoves}")
            return
 
        startRow, startColumn = buildPath(target, previous)[0]
        numMoves += 1
        movesThisRun += 1
 
    print("Objective met: False")
    print("Maximum moves reached.")
    print(f"Number of moves: {numMoves}")

def basicBot():
    moving = True
    objectiveMet = False
    while moving:
        #disturbances()
        global startRow, startColumn, numObjectivesMet, numMoves
        if startRow < 19 and grid[startRow + 1][startColumn] == 0:
            startRow += 1
            numMoves += 1
        

        elif startColumn < 19 and grid[startRow][startColumn + 1] == 0:
            startColumn += 1
            numMoves += 1

       
        elif startColumn > 0 and grid[startRow][startColumn - 1] == 0:
            startColumn -= 1
            numMoves += 1
        else:
            moving = False
            print(f"Number of moves: {numMoves}")
            print(f"Objective met: {objectiveMet}")

        if startRow == gemRow and startColumn == gemColumn:
            moving = False
            print(f"Number of moves: {numMoves}")
            objectiveMet = True
            numObjectivesMet += 1
            print(f"Objective met: {objectiveMet}")
        if numMoves > 199:
            moving = False
            print(f"Number of moves: {numMoves}")
            print(f"Objective met: {objectiveMet}")
    return None


